rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Set this custom claim only from a trusted Admin SDK environment.
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function validUid(uid) { return uid is string && uid.size() > 0 && uid.size() <= 128; }

    // Private registration documents may contain guardian contacts and verification metadata.
    // Never expose these documents to other members. Publish a separately sanitized publicProfiles
    // document from a trusted backend before enabling public profile discovery.
    match /registrations/{uid} {
      allow get: if owner(uid) || admin();
      allow list: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if owner(uid) && validUid(uid)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'candidateName', 'age'])
        && request.resource.data.candidateName is string
        && request.resource.data.candidateName.size() <= 100
        && request.resource.data.age is number
        && request.resource.data.age >= 18 && request.resource.data.age <= 100
        && (!('approvalStatus' in request.resource.data) || request.resource.data.approvalStatus == 'pending')
        && (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false);
      allow update: if (
        owner(uid)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasNone(['approvalStatus', 'verificationStatus', 'isVerified', 'approvalNotes', 'documents'])
      ) || (
        admin()
        && resource.data.userId == uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['approvalStatus', 'approvalNotes', 'updatedAt'])
        && request.resource.data.approvalStatus in ['pending', 'approved', 'rejected', 'suspended']
      );
      allow delete: if owner(uid) || admin();
    }

    // Sanitized profile discovery documents: only trusted backend/admin may publish or modify.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow write: if admin();
    }

    // All other collections are denied until their access model is explicitly implemented.
    match /{document=**} { allow read, write: if false; }
  }
}
