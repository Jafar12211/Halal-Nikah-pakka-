rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isEmailVerified() && request.auth.token.email == 'jafarmd0007@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidRegistration(data) {
      return data.keys().hasAll(['id', 'userId', 'candidateName', 'gender', 'age', 'city', 'createdAt']) &&
             data.keys().hasOnly([
               'id', 'userId', 'candidateName', 'gender', 'age', 'height', 'maritalStatus',
               'city', 'stateCountry', 'motherTongue', 'sect', 'religiousPractice',
               'education', 'profession', 'employedIn', 'annualIncomeRange',
               'familyDetails', 'partnerPreferences', 'aboutCandidate', 'guardianWaliContact',
               'isVerified', 'approvalStatus', 'verificationStatus', 'photos', 'photoPrivacy',
               'avatarInitials', 'avatarBgColor', 'createdAt', 'updatedAt', 'documents',
               'favoritesCount', 'interestsReceivedCount'
             ]) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.candidateName is string && data.candidateName.size() <= 100 &&
             data.city is string && data.city.size() <= 100 &&
             data.age is number && data.age >= 18 && data.age <= 100;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /registrations/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin() || existing().approvalStatus == 'approved');
      allow list: if isSignedIn() && (isAdmin() || resource.data.approvalStatus == 'approved' || resource.data.userId == request.auth.uid);

      allow create: if isEmailVerified() && isValidId(userId) && userId == request.auth.uid && isValidRegistration(incoming()) && incoming().userId == request.auth.uid;

      allow update: if isEmailVerified() && isValidId(userId) && (
        (isOwner(userId) && isValidRegistration(incoming()) && incoming().userId == existing().userId && incoming().approvalStatus == existing().approvalStatus) ||
        isAdmin()
      );

      allow delete: if isEmailVerified() && isValidId(userId) && (isOwner(userId) || isAdmin());
    }
  }
}
